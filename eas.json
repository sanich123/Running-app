{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "corepack": true,
      "channel": "production",
      "autoIncrement": true,
      "environment": "production"
    },
    "preview-production": {
      "distribution": "internal",
      "extends": "production",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview-production"
    },
    "preview-internal": {
      "corepack": true,
      "autoIncrement": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BASE_URL": "https://stage.runich-app.ru"
      },
      "channel": "preview-internal"
    },
    "development": {
      "extends": "production",
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "environment": "development",
      "env": {
        "APP_VARIANT": "development"
      },
      "channel": "development"
    }
  }
}
