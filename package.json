{
  "name": "runich-running-app",
  "version": "4.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "cross-env APP_VARIANT=development expo start",
    "start:clear": "cross-env APP_VARIANT=development expo start --clear",
    "start:prod": "expo start --no-dev --minify",
    "test": "cross-env IS_TESTING=true EXPO_PUBLIC_BASE_URL=https://runich-backend-production.up.railway.app jest --maxWorkers=50%",
    "test:coverage": "jest --coverage",
    "test:debug": "cross-env IS_TESTING=true jest --runInBand --detectOpenHandles --forceExit",
    "export:analyze:web": "npx expo export --source-maps --platform web",
    "export:analyze:ios": "npx expo export --source-maps --platform ios --no-bytecode",
    "export:analyze:android": "npx expo export --source-maps --platform android --no-bytecode",
    "analyze:web": "source-map-explorer 'dist/_expo/static/js/web/*.js' 'dist/_expo/static/js/web/*.js.map'",
    "analyze:ios": "source-map-explorer 'dist/_expo/static/js/ios/*.js' 'dist/_expo/static/js/ios/*.js.map'",
    "analyze:android": "source-map-explorer 'dist/_expo/static/js/android/*.js' 'dist/_expo/static/js/android/*.js.map'",
    "build:dev:android:cloud": "eas build --profile development --platform android",
    "build:dev:ios:emulator:cloud": "eas build --profile ios-simulator --platform ios",
    "build:preview:android:cloud": "eas build -p android --profile preview",
    "build:preview:ios:emulator:cloud": "eas build -p ios --profile preview",
    "build:dev:android:local": "APP_VARIANT=development EAS_LOCAL_BUILD_ARTIFACTS_DIR=~/Desktop eas build --profile development --platform android --local",
    "build:dev:ios:emulator:local": "APP_VARIANT=development EAS_LOCAL_BUILD_ARTIFACTS_DIR=~/Desktop eas build --profile ios-simulator --platform ios --local",
    "build:preview:android:local": "EAS_LOCAL_BUILD_ARTIFACTS_DIR=~/Desktop eas build --profile preview --platform android --local",
    "build:preview:ios:emulator:local": "EAS_LOCAL_BUILD_ARTIFACTS_DIR=~/Desktop eas build --profile preview --platform ios --local",
    "build:inspect": "eas build:inspect -p android -s archive -o ../build --profile=preview",
    "lint": "yarn expo lint",
    "deps:all": "yarn expo install --check && yarn expo install --fix",
    "prebuild:android": "npx expo prebuild --clean --platform android --no-install",
    "prebuild:ios": "npx expo prebuild --clean --platform ios --no-install",
    "prebuild:all": "npx expo prebuild --clean --no-install",
    "prepare": "husky",
    "android": "expo run:android --variant debug",
    "android:preview": "expo run:android --variant release",
    "ios": "expo run:ios",
    "ios:preview": "npx expo run:ios --configuration Release",
    "web:export": "expo export -p web -c",
    "web:serve:single": "npx serve dist --single",
    "web:serve": "npx serve dist",
    "web:deploy:netlify": "netlify deploy --dir dist",
    "web:deploy:prod": "netlify deploy --prod",
    "web:deploy:full": "yarn web:export && netlify deploy --prod",
    "eas-build-pre-install": "bash -c \"[ ! -z \\\"$EAS_BUILD_NPM_CACHE_URL\\\" ] && sed -i -e \\\"s#https://registry.yarnpkg.com#$EAS_BUILD_NPM_CACHE_URL#g\\\" yarn.lock\" || true"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@mapbox/polyline": "^1.2.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-google-signin/google-signin": "^15.0.0",
    "@react-native-picker/picker": "2.11.4",
    "@reduxjs/toolkit": "^2.12.0",
    "@rnmapbox/maps": "^10.3.5",
    "@supabase/supabase-js": "^2.112.0",
    "@turf/bbox": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "aes-js": "^3.1.2",
    "axios": "^1.19.0",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~57.0.9",
    "expo-auth-session": "~57.0.5",
    "expo-build-properties": "~57.0.8",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.8",
    "expo-dev-client": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.7",
    "expo-intent-launcher": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-location": "~57.0.7",
    "expo-media-library": "~57.0.3",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-task-manager": "~57.0.7",
    "expo-updates": "~57.0.11",
    "expo-video": "~57.0.2",
    "expo-video-thumbnails": "~57.0.1",
    "expo-vpn-checker": "^0.1.4",
    "expo-web-browser": "~57.0.2",
    "mapbox-gl": "^1.13.3",
    "moment": "^2.30.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.84.0",
    "react-native": "0.86.2",
    "react-native-battery-optimization-check": "^1.0.8",
    "react-native-compressor": "^1.12.0",
    "react-native-date-picker": "5.0.12",
    "react-native-edge-to-edge": "1.8.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-gifted-charts": "^1.4.77",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-pager-view": "8.0.2",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-tab-view": "^4.3.2",
    "react-native-toast-message": "2.4.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-uuid": "^2.0.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.3.0",
    "semver": "^7.8.5",
    "turf-linestring": "^1.0.2",
    "turf-point": "^2.0.1",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/aes-js": "^3.1.4",
    "@types/jest": "^30.0.0",
    "@types/mapbox-gl": "^2.7.21",
    "@types/react": "~19.2.18",
    "@types/validator": "^13.15.10",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-universe": "^15.2.0",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.3",
    "msw": "^1.3.5",
    "prettier": "^3.9.6",
    "react-native-zip-archive": "^7.0.2",
    "redux-persist": "^6.0.0",
    "source-map-explorer": "^2.5.3",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  },
  "main": "expo-router/entry",
  "author": "aovoronin.piano@gmail.com <aovoronin.piano@gmail.com>",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-compressor",
          "@react-native-vector-icons/material-design-icons"
        ]
      }
    },
    "install": {
      "exclude": [
        "jest",
        "@types/jest"
      ]
    }
  },
  "packageManager": "yarn@1.22.22"
}
