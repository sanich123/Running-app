{
  "name": "runich-running-app",
  "version": "1.3.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "expo start --clear",
    "test": "jest --maxWorkers=50% --no-watchman",
    "test:coverage": "yarn test --coverage",
    "test:debug": "jest --runInBand --detectOpenHandles --forceExit --no-watchman",
    "build:dev:android": "eas build --profile development -p android --local --output \"$HOME/Desktop/runich-app/$(date +%d-%m-%Y_%H-%M).apk\"",
    "build:preview:internal:android": "eas build --profile preview-internal -p android --local --output \"$HOME/Desktop/runich-app/$(date +%d-%m-%Y_%H-%M).apk\"",
    "build:preview:production:android": "eas build --profile preview-production -p android --local --output \"$HOME/Desktop/runich-app/$(date +%d-%m-%Y_%H-%M).apk\"",
    "build:production:android": "eas build -p android --local --output \"$HOME/Desktop/runich-app/$(date +%d-%m-%Y_%H-%M).aab\"",
    "build:dev:ios": "eas build --profile development -p ios --local --output \"$HOME/Desktop/runich-app/$(date +%d-%m-%Y_%H-%M).ipa\"",
    "build:preview:internal:ios": "eas build --profile preview -p ios --local --output \"$HOME/Desktop/runich-app/$(date +%d-%m-%Y_%H-%M).ipa\"",
    "build:production:ios": "eas build -p ios --local --output \"$HOME/Desktop/runich-app/$(date +%d-%m-%Y_%H-%M).ipa\"",
    "build:inspect": "eas build:inspect -p android -s archive -o ../build --profile=production",
    "cleanup:dev": "node scripts/cleanup-dev-artifacts.mjs",
    "cleanup:dev:apply": "node scripts/cleanup-dev-artifacts.mjs --apply",
    "prebuild:clean": "expo prebuild --clean",
    "prebuild": "expo prebuild",
    "android": "expo run:android --variant debug",
    "e2e:android": "node scripts/e2e-android.mjs",
    "e2e:android:skip-build": "node scripts/e2e-android.mjs --skip-build",
    "android:release": "expo run:android --variant release",
    "location:android:route": "node scripts/location-route.mjs",
    "ios": "expo run:ios",
    "ios:release": "expo run:ios --configuration release",
    "clear-cache:android": "rm -rf android/.gradle && rm -rf android/app/build && rm -rf node_modules && rm -rf ~/.gradle/caches",
    "export:atlas": "EXPO_ATLAS=true npx expo export",
    "show:atlas": "npx expo-atlas .expo/atlas.jsonl",
    "web:export:stage": "EXPO_PUBLIC_BASE_URL=https://stage.runich-app.ru EXPO_PUBLIC_MAPBOX_TOKEN=pk.eyJ1Ijoic2FuaWNoMTIzIiwiYSI6ImNtc3Z0MnV5ZDA1ZW4yd3M3d212NTg1dGsifQ.ETJENZqd5m-yPfVbnCf4pg expo export -p web -c",
    "web:export:production": "EXPO_PUBLIC_BASE_URL=https://api.runich-app.ru EXPO_PUBLIC_MAPBOX_TOKEN=pk.eyJ1Ijoic2FuaWNoMTIzIiwiYSI6ImNtc3Z0MnV5ZDA1ZW4yd3M3d212NTg1dGsifQ.ETJENZqd5m-yPfVbnCf4pg expo export -p web -c",
    "web:serve:single": "npx serve dist --single",
    "prepare": "husky",
    "deps": "yarn npm-check-updates",
    "lint": "expo lint"
  },
  "dependencies": {
