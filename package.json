{
  "name": "runich-running-app",
  "version": "3.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "cross-env APP_VARIANT=development expo start",
    "start:clear": "cross-env APP_VARIANT=development expo start --clear",
    "start:prod": "expo start --no-dev --minify",
    "test": "cross-env IS_TESTING=true EXPO_PUBLIC_BASE_URL=https://runich-backend-production.up.railway.app jest",
    "test:coverage": "jest --coverage",
    "test:debug": "cross-env IS_TESTING=true jest --runInBand --detectOpenHandles --forceExit",
    "export:analyze:web": "npx expo export --source-maps --platform web",
    "export:analyze:ios": "npx expo export --source-maps --platform ios --no-bytecode",
    "export:analyze:android": "npx expo export --source-maps --platform android --no-bytecode",
    "analyze:web": "source-map-explorer 'dist/_expo/static/js/web/*.js' 'dist/_expo/static/js/web/*.js.map'",
    "analyze:ios": "source-map-explorer 'dist/_expo/static/js/ios/*.js' 'dist/_expo/static/js/ios/*.js.map'",
    "analyze:android": "source-map-explorer 'dist/_expo/static/js/android/*.js' 'dist/_expo/static/js/android/*.js.map'",
    "build:dev:android:cloud": "eas build --profile development --platform android",
    "build:dev:ios:emulator:cloud": "eas build --profile ios-simulator --platform ios",
    "build:preview:android:cloud": "eas build -p android --profile preview",
    "build:preview:ios:emulator:cloud": "eas build -p ios --profile preview",
    "build:dev:android:local": "APP_VARIANT=development EAS_LOCAL_BUILD_ARTIFACTS_DIR=~/Desktop eas build --profile development --platform android --local",
    "build:dev:ios:emulator:local": "APP_VARIANT=development EAS_LOCAL_BUILD_ARTIFACTS_DIR=~/Desktop eas build --profile ios-simulator --platform ios --local",
    "build:preview:android:local": "EAS_LOCAL_BUILD_ARTIFACTS_DIR=~/Desktop eas build --profile preview --platform android --local",
    "build:preview:ios:emulator:local": "EAS_LOCAL_BUILD_ARTIFACTS_DIR=~/Desktop eas build --profile preview --platform ios --local",
    "build:inspect": "eas build:inspect -p android -s archive -o ../build --profile=preview",
    "lint": "yarn expo lint",
    "deps:all": "yarn expo install --check && yarn expo install --fix",
    "prebuild:android": "npx expo prebuild --clean --platform android",
    "prebuild:ios": "npx expo prebuild --clean --platform ios",
    "prebuild:all": "npx expo prebuild --clean",
    "prepare": "husky",
    "android": "expo run:android --variant debug",
    "android:preview": "expo run:android --variant release",
    "ios": "expo run:ios",
    "ios:preview": "npx expo run:ios --configuration Release",
    "web:export": "expo export -p web",
    "web:serve:single": "npx serve dist --single",
    "web:serve": "npx serve dist",
    "web:deploy:netlify": "netlify deploy --dir dist",
    "web:deploy:prod": "netlify deploy --prod",
    "web:deploy:full": "yarn web:export && netlify deploy --prod",
    "eas-build-pre-install": "bash -c \"[ ! -z \\\"$EAS_BUILD_NPM_CACHE_URL\\\" ] && sed -i -e \\\"s#https://registry.yarnpkg.com#$EAS_BUILD_NPM_CACHE_URL#g\\\" yarn.lock\" || true"
  },
  "jest": {
    "collectCoverage": true,
    "coverageReporters": [
      "json",
      "html"
    ],
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "./jest-setup.ts"
    ],
    "setupFiles": [
      "./tests/set-up-async-storage/set-up-async-storage.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|firebase|@firebase|@rnmapbox|react-redux)"
    ]
  },
  "dependencies": {
    "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
    "@expo/vector-icons": "^14.1.0",
    "@gorhom/bottom-sheet": "^5.1.4",
    "@mapbox/polyline": "^1.2.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-google-signin/google-signin": "^15.0.0",
    "@react-native-picker/picker": "2.11.1",
    "@reduxjs/toolkit": "^2.6.1",
    "@rnmapbox/maps": "^10.1.39",
    "@supabase/supabase-js": "^2.45.1",
    "@turf/bbox": "^6.5.0",
    "@turf/distance": "^6.5.0",
    "aes-js": "^3.1.2",
    "base64-arraybuffer": "^1.0.2",
    "expo": "53.0.17",
    "expo-auth-session": "~6.2.1",
    "expo-av": "~15.1.7",
    "expo-build-properties": "~0.14.8",
    "expo-camera": "~16.1.10",
    "expo-dev-client": "~5.2.4",
    "expo-device": "~7.1.4",
    "expo-document-picker": "~13.1.6",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-image": "~2.3.2",
    "expo-image-picker": "~16.1.4",
    "expo-intent-launcher": "~12.1.5",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.7",
    "expo-location": "~18.1.6",
    "expo-media-library": "~17.1.7",
    "expo-router": "~5.1.3",
    "expo-secure-store": "~14.2.3",
    "expo-sharing": "~13.1.5",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.10",
    "expo-task-manager": "~13.1.6",
    "expo-updates": "~0.28.16",
    "expo-video": "~2.2.2",
    "expo-video-thumbnails": "~9.1.3",
    "expo-web-browser": "~14.2.0",
    "mapbox-gl": "^1.13.2",
    "moment": "^2.29.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-battery-optimization-check": "^1.0.8",
    "react-native-compressor": "^1.11.0",
    "react-native-date-picker": "5.0.12",
    "react-native-edge-to-edge": "1.6.0",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-gifted-charts": "^1.4.61",
    "react-native-keyboard-controller": "^1.16.8",
    "react-native-pager-view": "6.7.1",
    "react-native-paper": "^5.14.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-toast-message": "2.3.0",
    "react-native-root-toast": "^3.5.1",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-tab-view": "^4.0.5",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-uuid": "^2.0.1",
    "react-native-vector-icons": "^10.0.0",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "^0.20.0",
    "react-redux": "^9.2.0",
    "turf-linestring": "^1.0.2",
    "turf-point": "^2.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.8.1",
    "@types/aes-js": "^3.1.4",
    "@types/jest": "^29.5.3",
    "@types/mapbox-gl": "^2.7.20",
    "@types/react": "~19.0.10",
    "@types/react-test-renderer": "^18.0.0",
    "abort-controller": "^3.0.0",
    "cross-env": "^7.0.3",
    "cross-fetch": "^4.0.0",
    "eslint": "^8",
    "eslint-config-expo": "~9.2.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-config-universe": "^12.0.0",
    "eslint-plugin-prettier": "^5.2.3",
    "husky": "^9.1.7",
    "jest": "^29.2.1",
    "jest-expo": "~53.0.9",
    "msw": "^1.3.5",
    "prettier": "^3.5.1",
    "react-native-zip-archive": "^7.0.1",
    "redux-persist": "^6.0.0",
    "source-map-explorer": "^2.5.3",
    "ts-jest": "^29.2.5",
    "typescript": "~5.8.3"
  },
  "eslintConfig": {
    "extends": "universe/native",
    "ignorePatterns": [
      "node_modules",
      ".expo",
      "android",
      "assets",
      "ios",
      ".husky",
      "assets",
      "coverage",
      ".yarn",
      "dist"
    ]
  },
  "prettier": {
    "endOfLine": "auto",
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "printWidth": 120,
    "bracketSameLine": true
  },
  "main": "expo-router/entry",
  "author": "aovoronin.piano@gmail.com <aovoronin.piano@gmail.com>",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": [
          "redux-persist"
        ]
      }
    }
  },
  "packageManager": "yarn@1.22.22"
}