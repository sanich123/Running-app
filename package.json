  "main": "expo-router/entry",
  "author": "aovoronin.piano@gmail.com <aovoronin.piano@gmail.com>",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-compressor",
          "@react-native-vector-icons/material-design-icons"
        ]
      }
    },
    "install": {
