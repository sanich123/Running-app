  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --config .prettierrc --write"
    ],
    "*.{css,html,json,jsonc,md,mdx,scss,yaml,yml}": "prettier --config .prettierrc --write"
