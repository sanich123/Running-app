#!/usr/bin/env sh
set -e

# 1. Проверка TypeScript
yarn tsc

# 2. Линтинг и форматирование staged-файлов
yarn lint-staged

# 3. Проверка состояния Expo
npx expo-doctor@latest || true

# 4. Тесты
yarn test

# 5. Проверка circular dependencies
yarn madge \
  --ts-config ./tsconfig.json \
  --warning \
  --circular \
  --extensions ts,tsx \
  ./app ./routes ./shared ./constants ./redux ./utils

# 6. Проверка неиспользуемых импортов ts-prune
yarn ts-prune --ignore 'app|jest.config.js|.*\.test\.(ts|tsx)$'

# 7. Обновление зависимостей
yarn npm-check-updates || true

# 8. Проверка неиспользуемых зависимостей опционально
yarn depcheck || true
